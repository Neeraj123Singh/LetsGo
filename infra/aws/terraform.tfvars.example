# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Run `aws configure` once on your laptop before applying so this module
# can read ~/.aws/credentials.

# AWS region you want the VM in. Pick whichever is closest to your users.
# Common: "us-east-1" (N. Virginia), "us-west-2" (Oregon), "ap-south-1" (Mumbai),
# "eu-central-1" (Frankfurt), "ap-southeast-1" (Singapore).
region = "ap-south-1"

# Profile name inside ~/.aws/credentials. The default profile from
# `aws configure` is just called "default".
aws_profile = "default"

# Public half of the SSH key you'll use to log into the VM. Will be uploaded
# as an EC2 key pair named "${name_prefix}-key".
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# OPTIONAL — restrict SSH to your home IP for safety:
# ssh_ingress_cidr = "203.0.113.42/32"

# Where the cloud-init script should clone the app from on first boot.
git_repo_url    = "https://github.com/your-user/letsgo.git"
git_repo_branch = "main"

# OPTIONAL — instance sizing. Defaults to t3.micro (free tier, 1 GB RAM).
# See variables.tf for trade-offs. The app needs ≥2 GB to be stable.
# instance_type  = "t3.micro"
# root_volume_gb = 30
# swap_size_gb   = 2
