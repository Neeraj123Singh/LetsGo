# Copy to `.env.prod` and fill in the values below. NEVER commit `.env.prod`.
# Used by `docker compose --env-file .env.prod -f docker-compose.prod.yml ...`.

# Public DNS name pointing at the VM's public IPv4. Caddy will request a
# Let's Encrypt certificate for this hostname, so the A record must resolve
# to the VM BEFORE the first `docker compose up`.
DOMAIN=letsgo.example.com

# Email address Let's Encrypt should contact about certificate expiry.
ACME_EMAIL=you@example.com

# Database password used by Postgres, auth-java, meeting-go, and the migrate
# image. Pick a long random value.
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Shared HMAC secret for JWT issuance (auth-java) and validation (meeting-go).
# MUST be the same value for both services. ≥32 bytes.
#   openssl rand -base64 48
LETSGO_JWT_SECRET=

# TURN server long-term credentials. The frontend bakes these into the JS
# bundle so users can use the TURN relay. Rotate by regenerating + rebuilding
# the frontend image (`docker compose ... up -d --build --force-recreate frontend`).
#   openssl rand -hex 16
TURN_USER=letsgo
TURN_PASS=

# Public IPv4 of the VM. coturn advertises this address in ICE candidates so
# remote peers know where to send media. Find it via `curl -4 ifconfig.me` on
# the VM, or in your cloud provider's console.
TURN_EXTERNAL_IP=
